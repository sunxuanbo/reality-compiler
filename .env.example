# 通用 OpenAI Chat Completions 兼容接口配置模板
# 用法：复制本文件为 .env，填入真实密钥后启动应用。
#   cp .env.example .env
# 注意：.env 含密钥，请勿提交到版本库。

# 远程服务 API Key（本机 localhost 接口可留空）。
AI_API_KEY=

# 接口根地址或完整 /chat/completions 地址。
AI_API_BASE=https://api.deepseek.com

# 服务商实际提供的模型 ID。
AI_MODEL=deepseek-chat

# 旧版 DEEPSEEK_API_KEY / DEEPSEEK_API_BASE / DEEPSEEK_MODEL 仍兼容。
